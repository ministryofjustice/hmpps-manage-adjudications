{% extends "../partials/layout.njk" %}
{% from "../partials/breadCrumb.njk" import breadcrumb %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% set title = title or "Do you have the details of the rehabilitative activity?" %}
{% block pageTitle %}
  {{ title }} - Adjudications - Digital Prison Services
{% endblock %}
{% block beforeContent %}
  {{ breadcrumb() }}
{% endblock %}

{% set numberOfActivitiesHtml %}
  {{ govukInput({
      id: "numberOfActivities",
      name: "numberOfActivities",
      inputmode: "numeric",
      value: numberOfActivities,
      classes: "govuk-input--width-2",
      attributes: { "data-qa": "number-of-activities" },
      errorMessage: errors | findErrors(["numberOfActivities"]),
      label: {
          text: "Enter the number of rehabilitative activities"
      }
    }) }}
{% endset -%}

{% set items = [
    {
        value: "YES",
        text: "Yes",
        checked: hasRehabilitativeActivitiesDetails === 'YES',
        conditional: { html: numberOfActivitiesHtml } if askNumberOfActivities else undefined
    },
    {
        value: "NO",
        text: "No",
        checked: hasRehabilitativeActivitiesDetails === 'NO',
        hint: {
            text: "You can return to this report to enter the details once you have them."
        }
    }
] %}


{% block content %}
  {% if errors | length %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: errors,
      attributes: { "data-qa": "error-summary" }
    }) }}
  {% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
    {% if appliesTo | length %}
      <h1 class="govuk-heading-l govuk-!-margin-top-5">{{ title }}</h1>
      <p class="govuk-body">These answers will be applied to:</p>
      <ul class="govuk-list govuk-list--bullet" data-qa="applies-to">
        {% for name in appliesTo %}
          <li>{{ name }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    <form method="POST" novalidate="novalidate" class="{{ 'govuk-!-margin-top-5' if not appliesTo | length }}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>

        {{ govukRadios({
    idPrefix: 'hasRehabilitativeActivitiesDetails',
    id: 'hasRehabilitativeActivitiesDetails',
    name: 'hasRehabilitativeActivitiesDetails',
    attributes: { "data-qa": "hasRehabilitativeActivitiesDetails-radios" },
    errorMessage: "hasRehabilitativeActivitiesDetails" | findError(errors),
    hint: {
    text: "This includes what the activity is, when it needs to be completed by and who will be monitoring the prisoner on the activity."
     },
    items: items,
    fieldset: {
    legend: {
      text: "Rehabilitative activity details" if appliesTo | length else title,
      isPageHeading: not appliesTo | length,
      classes: "govuk-visually-hidden" if appliesTo | length else "govuk-fieldset__legend--l"
    }
  }
 }) }}
      
      <div class="govuk-button-group">
        {{ govukButton({
              text: 'Save and continue' if featureToggles.multiPrivilegePunishments else 'Continue',
              type: "submit",
              preventDoubleClick: true,
              classes: "govuk-button--submit govuk-!-margin-right-3",
              attributes: { "data-qa": "punishment-submit" }
              }) }}

        <a class="govuk-link" href=' {{ cancelHref }} ' data-qa='punishment-cancel'>Return to ‘Award punishments and add money for damages’</a>
      </div>

    </form>
    </div>
  </div>
{% endblock %}